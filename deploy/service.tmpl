[Unit]
Description=Your Ceiba (your-ceiba) ceiba — FastAPI on port 8200
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/your-ceiba
ExecStart=%h/your-ceiba/.venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8200
Restart=on-failure
RestartSec=3
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=default.target
