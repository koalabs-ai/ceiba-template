# Snippet para incluir en el Caddyfile canónico (koa-files:/etc/caddy/Caddyfile).
# Reemplaza your-ceiba.example y 8200 antes de pegar.
#
# Workflow: pull-diff-push-smoketest.
#   ssh inge@100.64.0.4 'cat /etc/caddy/Caddyfile' > /tmp/Caddyfile
#   # ... editar localmente, agregar este snippet ...
#   rsync -av /tmp/Caddyfile inge@100.64.0.4:/tmp/Caddyfile
#   ssh inge@100.64.0.4 'sudo cp /tmp/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy'

your-ceiba.example {
  encode gzip zstd
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "geolocation=(), microphone=(), camera=()"
  }
  reverse_proxy 100.64.0.5:8200
}
