# Snippet to include in your canonical Caddyfile (wherever Caddy's config lives
# on your reverse-proxy host).
# Replace your-ceiba.example and 8200 before pasting.
#
# Suggested workflow: pull-diff-push-smoketest.
#   ssh <user>@<proxy-host> 'cat /etc/caddy/Caddyfile' > /tmp/Caddyfile
#   # ... edit locally, add this snippet ...
#   rsync -av /tmp/Caddyfile <user>@<proxy-host>:/tmp/Caddyfile
#   ssh <user>@<proxy-host> 'sudo cp /tmp/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy'

your-ceiba.example {
  encode gzip zstd
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "geolocation=(), microphone=(), camera=()"
  }
  reverse_proxy 127.0.0.1:8200
}
